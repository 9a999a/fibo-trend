// © LonesomeTheBlue — original "ZigZag with Fibonacci Levels"
// Modified: levels replaced with the Fibo Trend strategy levels (1 / 0.65 / 0.5 / 0 / -0.6 / -1.1 / -1.6 / -1.9)

//@version=4
study("ZigZag Fibo Trend Levels", overlay = true, max_bars_back = 500, max_lines_count = 300, max_labels_count = 300)
prd = input(defval = 15, title="ZigZag Period", minval = 2, maxval = 50)
showzigzag = input(defval = true, title = "Show Zig Zag")
showfibo = input(defval = true, title = "Show Fibonacci Levels")
upcol = input(defval = color.lime, title = "Zigzag Colors", inline = "zzcol")
dncol = input(defval = color.red, title = "", inline = "zzcol")
labelloc = input(defval = "Right", title = "Label Location", options = ["Left", "Right"])
enable1   = input(defval = true, title = "Level 1     (reversal candle)")
enable065 = input(defval = true, title = "Level 0.65  (stop: close beyond)")
enable05  = input(defval = true, title = "Level 0.5   (entry: close beyond)")
enable0   = input(defval = true, title = "Level 0     (TP1 - capital out)")
enableM06 = input(defval = true, title = "Level -0.6  (TP2)")
enableM11 = input(defval = true, title = "Level -1.1  (TP3 - golden, close all)")
enableM16 = input(defval = true, title = "Level -1.6")
enableM19 = input(defval = true, title = "Level -1.9")

var fibo_ratios = array.new_float(0)
if barstate.isfirst
    if enable1
        array.push(fibo_ratios, 1.0)
    if enable065
        array.push(fibo_ratios, 0.65)
    if enable05
        array.push(fibo_ratios, 0.5)
    if enable0
        array.push(fibo_ratios, 0.0)
    if enableM06
        array.push(fibo_ratios, -0.6)
    if enableM11
        array.push(fibo_ratios, -1.1)
    if enableM16
        array.push(fibo_ratios, -1.6)
    if enableM19
        array.push(fibo_ratios, -1.9)

levelColor(r) =>
    r == 1.0  ? color.red :
     r == 0.65 ? color.teal :
     r == 0.5  ? color.green :
     r == 0.0  ? color.gray :
     r == -0.6 ? color.aqua :
     r == -1.1 ? color.orange :
     r == -1.6 ? color.fuchsia : color.blue

float ph = highestbars(high, prd) == 0 ? high : na
float pl = lowestbars(low, prd) == 0 ? low : na
var dir = 0
dir := iff(ph and na(pl), 1, iff(pl and na(ph), -1, dir))
var max_array_size = 10
var zigzag = array.new_float(0)
oldzigzag = array.copy(zigzag)

add_to_zigzag(value, bindex)=>
    array.unshift(zigzag, bindex)
    array.unshift(zigzag, value)
    if array.size(zigzag) > max_array_size
        array.pop(zigzag)
        array.pop(zigzag)

update_zigzag(value, bindex)=>
    if array.size(zigzag) == 0
        add_to_zigzag(value, bindex)
    else
        if (dir == 1 and value > array.get(zigzag, 0)) or (dir == -1 and value < array.get(zigzag, 0))
            array.set(zigzag, 0, value)
            array.set(zigzag, 1, bindex)
        0.

bool dirchanged = (dir != dir[1])
if ph or pl
    if dirchanged
        add_to_zigzag(dir == 1 ? ph : pl, bar_index)
    else
        update_zigzag(dir == 1 ? ph : pl, bar_index)

if showzigzag and array.size(zigzag) >= 4 and array.size(oldzigzag) >= 4
    var line zzline = na
    if array.get(zigzag, 0) != array.get(oldzigzag, 0) or array.get(zigzag, 1) != array.get(oldzigzag, 1)
        if array.get(zigzag, 2) == array.get(oldzigzag, 2) and array.get(zigzag, 3) == round(array.get(oldzigzag, 3))
            line.delete(zzline)
        zzline := line.new(x1 = round(array.get(zigzag, 1)), y1 = array.get(zigzag, 0), x2 = round(array.get(zigzag, 3)), y2 = array.get(zigzag, 2), color = dir == 1 ? upcol : dncol, width = 2)

// Fib on the last completed swing: level 1 = older pivot, level 0 = newer pivot,
// negative levels extend beyond level 0.
var fibolines = array.new_line(0)
var fibolabels = array.new_label(0)
if showfibo and array.size(zigzag) >= 6 and barstate.islast and array.size(fibo_ratios) > 0
    if array.size(fibolines) > 0
        for x = 0 to array.size(fibolines) - 1
            line.delete(array.get(fibolines, x))
            label.delete(array.get(fibolabels, x))
        array.clear(fibolines)
        array.clear(fibolabels)

    diff = array.get(zigzag, 4) - array.get(zigzag, 2)
    for x = 0 to array.size(fibo_ratios) - 1
        r = array.get(fibo_ratios, x)
        y = array.get(zigzag, 2) + diff * r
        col = levelColor(r)
        array.unshift(fibolines,
                      line.new(x1 = round(array.get(zigzag, 5)),
                               y1 = y,
                               x2 = bar_index,
                               y2 = y,
                               color = col,
                               extend = extend.right))
        label_x_loc = labelloc == "Left" ? round(array.get(zigzag, 5)) - 1 : bar_index + 15
        array.unshift(fibolabels,
                      label.new( x = label_x_loc,
                                 y = y,
                                 text = tostring(r, '#.##') + " (" + tostring(round_to_mintick(y)) + ")",
                                 textcolor = col,
                                 style = label.style_none))
