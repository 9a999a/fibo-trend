// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// Fibo Trend Strategy v2 — rules as explained by the strategy author
//
//   Fib is drawn on the 15m timeframe (configurable):
//     1    = reversal candle (the rectangle / broken zone)
//     0    = end of the move away from the reversal candle
//   Entry  : candle CLOSES below 0.5 (bearish) / above 0.5 (bullish) after price pulls back to it
//   Stop   : candle CLOSES above 0.65 (bearish) / below 0.65 (bullish)
//   TP1  0    = take out capital (partial close + stop to breakeven)
//   TP2 -0.6  = second target
//   TP3 -1.1  = golden target, close everything
//   -1.6 / -1.9 are drawn for reference only.
//
//@version=6
strategy("Fibo Trend Strategy v2", shorttitle = "FiboTrend", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.01,
     slippage = 1, max_lines_count = 100, max_labels_count = 100, max_boxes_count = 50)

// ───────────────────────────── Inputs ─────────────────────────────
grpS = "Fib swing (reversal candle)"
fibTf      = input.timeframe("15", "Fib timeframe", group = grpS)
pivLen     = input.int(3, "Pivot length (bars each side, on fib TF)", minval = 1, group = grpS)
anchor1    = input.string("Zone edge", "Level 1 anchor", options = ["Zone edge", "Candle wick"], group = grpS,
     tooltip = "Zone edge: level 1 = the side of the reversal candle that gets broken (bottom of the rectangle in a down move).\nCandle wick: level 1 = the extreme of the reversal candle.")
minLegPct  = input.float(0.03, "Min leg size (%)", minval = 0.0, step = 0.01, group = grpS)
expiryBars = input.int(60, "Setup expiry (chart bars)", minval = 5, group = grpS)

grpF = "Levels"
entryLvl = input.float(0.5,  "Entry level (close beyond)", step = 0.01, group = grpF)
stopLvl  = input.float(0.65, "Stop level (close beyond)",  step = 0.01, group = grpF)
tp1Lvl   = input.float(0.0,  "TP1 – capital out", step = 0.1, group = grpF)
tp2Lvl   = input.float(-0.6, "TP2", step = 0.1, group = grpF)
tp3Lvl   = input.float(-1.1, "TP3 – golden / close all", step = 0.1, group = grpF)
useHard  = input.bool(true, "Hard safety stop at level 1", group = grpF,
     tooltip = "Protects against a single huge candle before the close-based stop can trigger.")
slBufT   = input.int(5, "Hard stop buffer (ticks)", minval = 0, group = grpF)

grpE = "Exits"
q1     = input.float(50, "% closed at TP1 (level 0)", minval = 0, maxval = 100, group = grpE)
q2     = input.float(25, "% closed at TP2 (-0.6)",    minval = 0, maxval = 100, group = grpE)
moveBE = input.bool(true, "Stop to breakeven after TP1", group = grpE)

grpT = "Filters"
tradeDir = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = grpT)
useSess  = input.bool(false, "Trade only inside session", group = grpT)
sess     = input.session("1630-2300", "Session", group = grpT)
sessTz   = input.string("Asia/Riyadh", "Session timezone", group = grpT)

grpV = "Display"
showFib = input.bool(true, "Draw Fibonacci + reversal zone", group = grpV)

if timeframe.in_seconds(fibTf) < timeframe.in_seconds()
    runtime.error("Fib timeframe must be equal to or higher than the chart timeframe (use a 5m or 15m chart).")

// ───────────────────────────── Swing engine (runs on fib TF) ─────────────────────────────
// returns: direction (1 up-move / -1 down-move), fib0, fib1, zone top, zone bottom, zone time, setup id
swingEngine(int len, bool edge) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    var float hiP = na
    var float hiOther = na     // low of the pivot-high candle
    var int   hiT = na
    var float loP = na
    var float loOther = na     // high of the pivot-low candle
    var int   loT = na
    var int   lastT = 0
    var int   sDir = 0
    var float s0 = na
    var float s1 = na
    var float zTop = na
    var float zBot = na
    var int   zT = na
    var int   sid = 0
    if not na(ph)
        if lastT == 1
            if ph > hiP
                hiP := ph
                hiOther := low[len]
                hiT := time[len]
                if sDir == 1
                    s0 := hiP
                    sid += 1
        else
            hiP := ph
            hiOther := low[len]
            hiT := time[len]
            lastT := 1
            if not na(loP)
                // up-move: reversal candle = pivot-low candle
                sDir := 1
                s0 := hiP
                s1 := edge ? loOther : loP
                zTop := loOther
                zBot := loP
                zT := loT
                sid += 1
    if not na(pl)
        if lastT == -1
            if pl < loP
                loP := pl
                loOther := high[len]
                loT := time[len]
                if sDir == -1
                    s0 := loP
                    sid += 1
        else
            loP := pl
            loOther := high[len]
            loT := time[len]
            lastT := -1
            if not na(hiP)
                // down-move: reversal candle = pivot-high candle
                sDir := -1
                s0 := loP
                s1 := edge ? hiOther : hiP
                zTop := hiP
                zBot := hiOther
                zT := hiT
                sid += 1
    [sDir, s0, s1, zTop, zBot, zT, sid]

[hDir, hF0, hF1, hZTop, hZBot, hZT, hId] = request.security(syminfo.tickerid, fibTf,
     swingEngine(pivLen, anchor1 == "Zone edge"), lookahead = barmerge.lookahead_off)

// ───────────────────────────── Setup state (chart TF) ─────────────────────────────
var int   setDir  = 0
var float f0      = na
var float f1      = na
var int   setBar  = na
var bool  touched = false
var int   zoneT   = na
var float zoneTop = na
var float zoneBot = na

fib(x) => f0 + (f1 - f0) * x

newSetup = not na(hId) and hId != nz(hId[1], -1)
if newSetup and strategy.position_size == 0 and hDir != 0
    sideOk = hDir == 1 ? hF0 > hF1 : hF1 > hF0
    legOk = not na(hF0) and not na(hF1) and sideOk and math.abs(hF0 - hF1) / hF1 * 100 >= minLegPct
    setDir  := legOk ? hDir : 0
    f0      := hF0
    f1      := hF1
    zoneT   := hZT
    zoneTop := hZTop
    zoneBot := hZBot
    setBar  := bar_index
    touched := false

inSess = not useSess or not na(time(timeframe.period, sess, sessTz))
allowL = tradeDir != "Short only"
allowS = tradeDir != "Long only"

// pull-back to the entry level
if setDir == 1 and low <= fib(entryLvl)
    touched := true
if setDir == -1 and high >= fib(entryLvl)
    touched := true

// invalidation before entry: closed beyond the stop level, or expired
if strategy.position_size == 0 and setDir == 1 and (close < fib(stopLvl) or bar_index - setBar > expiryBars)
    setDir := 0
if strategy.position_size == 0 and setDir == -1 and (close > fib(stopLvl) or bar_index - setBar > expiryBars)
    setDir := 0

// ───────────────────────────── Entries ─────────────────────────────
longSig  = setDir == 1  and touched and strategy.position_size == 0 and allowL and inSess and
     close > fib(entryLvl) and close < fib(tp1Lvl)
shortSig = setDir == -1 and touched and strategy.position_size == 0 and allowS and inSess and
     close < fib(entryLvl) and close > fib(tp1Lvl)

var float eStopC = na     // close-based stop level (0.65)
var float eHard  = na     // hard safety stop (level 1)
var float eTP1   = na
var float eTP2   = na
var float eTP3   = na
var bool  beOn   = false

jsonMsg(string side, float px, float stp, float t1, float t2, float t3) =>
    '{"strategy":"FiboTrend","action":"' + side + '","symbol":"' + syminfo.ticker +
     '","exchange":"' + syminfo.prefix + '","timeframe":"' + timeframe.period +
     '","price":' + str.tostring(px) + ',"sl":' + str.tostring(stp) +
     ',"tp1":' + str.tostring(t1) + ',"tp2":' + str.tostring(t2) + ',"tp3":' + str.tostring(t3) +
     ',"time":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ssZ", "UTC") + '"}'

slBuf = slBufT * syminfo.mintick

if longSig
    eStopC := fib(stopLvl)
    eHard  := fib(1.0) - slBuf
    eTP1   := fib(tp1Lvl)
    eTP2   := fib(tp2Lvl)
    eTP3   := fib(tp3Lvl)
    beOn   := false
    strategy.entry("Long", strategy.long)
    alert(jsonMsg("buy", close, eStopC, eTP1, eTP2, eTP3), alert.freq_once_per_bar_close)
    setDir := 0

if shortSig
    eStopC := fib(stopLvl)
    eHard  := fib(1.0) + slBuf
    eTP1   := fib(tp1Lvl)
    eTP2   := fib(tp2Lvl)
    eTP3   := fib(tp3Lvl)
    beOn   := false
    strategy.entry("Short", strategy.short)
    alert(jsonMsg("sell", close, eStopC, eTP1, eTP2, eTP3), alert.freq_once_per_bar_close)
    setDir := 0

// ───────────────────────────── Exits ─────────────────────────────
// TP1 reached -> breakeven
if strategy.position_size > 0 and not beOn and high >= eTP1
    beOn := moveBE
if strategy.position_size < 0 and not beOn and low <= eTP1
    beOn := moveBE

// close-based stop (0.65), only while not at breakeven
if strategy.position_size > 0 and not beOn and close < eStopC
    strategy.close("Long", comment = "SL close<0.65")
    alert(jsonMsg("close_long", close, eStopC, eTP1, eTP2, eTP3), alert.freq_once_per_bar_close)
if strategy.position_size < 0 and not beOn and close > eStopC
    strategy.close("Short", comment = "SL close>0.65")
    alert(jsonMsg("close_short", close, eStopC, eTP1, eTP2, eTP3), alert.freq_once_per_bar_close)

stopL = beOn ? strategy.position_avg_price : (useHard ? eHard : na)
stopS = beOn ? strategy.position_avg_price : (useHard ? eHard : na)

if strategy.position_size > 0 or longSig
    strategy.exit("L-TP1", "Long", qty_percent = q1, limit = eTP1, stop = stopL, comment_profit = "TP1 0", comment_loss = beOn ? "BE" : "Hard SL")
    strategy.exit("L-TP2", "Long", qty_percent = q2, limit = eTP2, stop = stopL, comment_profit = "TP2 -0.6", comment_loss = beOn ? "BE" : "Hard SL")
    strategy.exit("L-TP3", "Long", limit = eTP3, stop = stopL, comment_profit = "TP3 -1.1", comment_loss = beOn ? "BE" : "Hard SL")

if strategy.position_size < 0 or shortSig
    strategy.exit("S-TP1", "Short", qty_percent = q1, limit = eTP1, stop = stopS, comment_profit = "TP1 0", comment_loss = beOn ? "BE" : "Hard SL")
    strategy.exit("S-TP2", "Short", qty_percent = q2, limit = eTP2, stop = stopS, comment_profit = "TP2 -0.6", comment_loss = beOn ? "BE" : "Hard SL")
    strategy.exit("S-TP3", "Short", limit = eTP3, stop = stopS, comment_profit = "TP3 -1.1", comment_loss = beOn ? "BE" : "Hard SL")

// ───────────────────────────── Drawing ─────────────────────────────
var array<line>  fLines  = array.new<line>()
var array<label> fLabels = array.new<label>()
var box zoneBox = na
lvls = array.from(1.0, stopLvl, entryLvl, tp1Lvl, tp2Lvl, tp3Lvl, -1.6, -1.9)

lvlColor(int i) =>
    switch i
        0 => color.gray
        1 => color.red
        2 => color.green
        3 => color.gray
        4 => color.aqua
        5 => color.orange
        6 => color.fuchsia
        => color.blue

if showFib and newSetup and setDir != 0
    for l in fLines
        line.delete(l)
    for lb in fLabels
        label.delete(lb)
    array.clear(fLines)
    array.clear(fLabels)
    box.delete(zoneBox)
    zoneBox := box.new(zoneT, zoneTop, time, zoneBot, xloc = xloc.bar_time,
         border_color = color.new(color.red, 60), bgcolor = color.new(setDir == -1 ? color.red : color.green, 85))
    for [i, x] in lvls
        y = fib(x)
        fLines.push(line.new(zoneT, y, time, y, xloc = xloc.bar_time, color = lvlColor(i)))
        fLabels.push(label.new(time, y, str.tostring(x) + " (" + str.tostring(y, format.mintick) + ")",
             xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100),
             textcolor = lvlColor(i), size = size.small))

if showFib and array.size(fLines) > 0 and (setDir != 0 or strategy.position_size != 0)
    for l in fLines
        line.set_x2(l, time)
    for lb in fLabels
        label.set_x(lb, time)
    box.set_right(zoneBox, time)

plotshape(longSig,  "Buy",  shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(shortSig, "Sell", shape.triangledown, location.abovebar, color.red,   size = size.small)
plot(strategy.position_size != 0 and not beOn ? eStopC : na, "Stop (close)", color.red, style = plot.style_linebr)
plot(strategy.position_size != 0 ? eTP1 : na, "TP1 (0)",    color.gray,   style = plot.style_linebr)
plot(strategy.position_size != 0 ? eTP2 : na, "TP2 (-0.6)", color.aqua,   style = plot.style_linebr)
plot(strategy.position_size != 0 ? eTP3 : na, "TP3 (-1.1)", color.orange, style = plot.style_linebr)
