// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// Fibo Trend Strategy v3
//
//   Fib is drawn on the LEG THAT ENDS AT THE REVERSAL CANDLE (fib timeframe, default 15m):
//     0  = previous swing (the high before a drop / the low before a rally)
//     1  = reversal candle (the extreme of the drop / rally)
//   Entry  : price turns and a candle CLOSES back beyond 0.5 (above for longs, below for shorts)
//   Stop   : a candle CLOSES back beyond 0.65
//   TP1  0    = previous swing, take out capital (partial close + stop to breakeven)
//   TP2 -0.6
//   TP3 -1.1  = golden target, close everything
//   -1.6 / -1.9 drawn for reference.
//
//@version=6
strategy("Fibo Trend Strategy v3", shorttitle = "FiboTrend", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 2, max_lines_count = 100, max_labels_count = 100, max_boxes_count = 50)

// ───────────────────────────── Inputs ─────────────────────────────
grpS = "Fib leg"
fibTf     = input.timeframe("15", "Fib timeframe", group = grpS)
pivLen    = input.int(5, "Swing pivot length (bars each side, fib TF)", minval = 2, group = grpS,
     tooltip = "Used to find the previous swing (level 0).")
anchor1   = input.string("Candle wick", "Level 1 anchor", options = ["Candle wick", "Candle body edge"], group = grpS,
     tooltip = "Candle wick: level 1 = low (long) / high (short) of the reversal candle.\nCandle body edge: level 1 = the opposite end of the reversal candle (the broken side of the rectangle).")
minLegAtr = input.float(1.5, "Min leg size (x ATR of fib TF)", minval = 0.0, step = 0.1, group = grpS)
minLegPct = input.float(0.05, "Min leg size (%)", minval = 0.0, step = 0.01, group = grpS)

grpF = "Levels"
entryLvl = input.float(0.5,  "Entry level (close beyond)", step = 0.01, group = grpF)
stopLvl  = input.float(0.65, "Stop level (close beyond)",  step = 0.01, group = grpF)
tp1Lvl   = input.float(0.0,  "TP1 – capital out", step = 0.1, group = grpF)
tp2Lvl   = input.float(-0.6, "TP2", step = 0.1, group = grpF)
tp3Lvl   = input.float(-1.1, "TP3 – golden / close all", step = 0.1, group = grpF)
useHard  = input.bool(true, "Hard safety stop at level 1", group = grpF)
slBufT   = input.int(5, "Hard stop buffer (ticks)", minval = 0, group = grpF)

grpE = "Exits"
q1     = input.float(50, "% closed at TP1 (level 0)", minval = 0, maxval = 100, group = grpE)
q2     = input.float(25, "% closed at TP2 (-0.6)",    minval = 0, maxval = 100, group = grpE)
moveBE = input.bool(true, "Stop to breakeven after TP1", group = grpE)

grpT = "Filters"
tradeDir = input.string("Both", "Direction", options = ["Both", "Long only", "Short only"], group = grpT)
useSess  = input.bool(false, "Trade only inside session", group = grpT)
sess     = input.session("1630-2300", "Session", group = grpT)
sessTz   = input.string("Asia/Riyadh", "Session timezone", group = grpT)

grpV = "Display"
showFib = input.bool(true, "Draw Fibonacci of each trade", group = grpV)

if timeframe.in_seconds(fibTf) < timeframe.in_seconds()
    runtime.error("Fib timeframe must be equal to or higher than the chart timeframe (use a 5m or 15m chart).")

// ───────────────────────────── Leg engine (runs on fib TF) ─────────────────────────────
// Long leg : last swing high (level 0)  -> lowest candle since then (reversal, level 1)
// Short leg: last swing low  (level 0)  -> highest candle since then (reversal, level 1)
legEngine(int len) =>
    ph = ta.pivothigh(high, len, len)
    pl = ta.pivotlow(low, len, len)
    var float phP  = na
    var int   phT  = na
    var float loS  = na    // lowest low since the swing high
    var float loOp = na    // other end of that candle (its high)
    var int   loT  = na
    var float plP  = na
    var int   plT  = na
    var float hiS  = na    // highest high since the swing low
    var float hiOp = na    // other end of that candle (its low)
    var int   hiT  = na
    if not na(ph)
        phP := ph
        phT := time[len]
        loS := na
        for i = len - 1 to 0
            if na(loS) or low[i] < loS
                loS  := low[i]
                loOp := high[i]
                loT  := time[i]
    else if not na(loS) and low < loS
        loS  := low
        loOp := high
        loT  := time
    if not na(pl)
        plP := pl
        plT := time[len]
        hiS := na
        for i = len - 1 to 0
            if na(hiS) or high[i] > hiS
                hiS  := high[i]
                hiOp := low[i]
                hiT  := time[i]
    else if not na(hiS) and high > hiS
        hiS  := high
        hiOp := low
        hiT  := time
    [phP, phT, loS, loOp, loT, plP, plT, hiS, hiOp, hiT, ta.atr(14)]

[phP, phT, loS, loOp, loT, plP, plT, hiS, hiOp, hiT, hAtr] = request.security(syminfo.tickerid, fibTf,
     legEngine(pivLen), lookahead = barmerge.lookahead_off)

fibAt(float a0, float a1, float x) => a0 + (a1 - a0) * x

wick = anchor1 == "Candle wick"

// long leg: 0 = swing high, 1 = reversal low
f0L  = phP
f1L  = wick ? loS : loOp
legL = f0L - f1L
// short leg: 0 = swing low, 1 = reversal high
f0S  = plP
f1S  = wick ? hiS : hiOp
legS = f1S - f0S

inSess = not useSess or not na(time(timeframe.period, sess, sessTz))
allowL = tradeDir != "Short only"
allowS = tradeDir != "Long only"

var int lastLegL = na
var int lastLegS = na

okL = not na(f0L) and not na(f1L) and loT > phT and legL > 0 and legL >= minLegAtr * hAtr and legL / f0L * 100 >= minLegPct and loT != nz(lastLegL, -1)
okS = not na(f0S) and not na(f1S) and hiT > plT and legS > 0 and legS >= minLegAtr * hAtr and legS / f0S * 100 >= minLegPct and hiT != nz(lastLegS, -1)

entL = fibAt(f0L, f1L, entryLvl)
entS = fibAt(f0S, f1S, entryLvl)

longSig  = okL and strategy.position_size == 0 and allowL and inSess and
     close > entL and close[1] <= entL and close < fibAt(f0L, f1L, tp1Lvl)
shortSig = okS and strategy.position_size == 0 and allowS and inSess and
     close < entS and close[1] >= entS and close > fibAt(f0S, f1S, tp1Lvl) and not longSig

// ───────────────────────────── Trade levels (frozen at entry) ─────────────────────────────
var float e0     = na
var float e1     = na
var float eStopC = na
var float eHard  = na
var float eTP1   = na
var float eTP2   = na
var float eTP3   = na
var bool  beOn   = false
var int   dLegT  = na     // drawing anchors
var int   dRevT  = na
var float dRevA  = na
var float dRevB  = na

jsonMsg(string side, float px, float stp, float t1, float t2, float t3) =>
    '{"strategy":"FiboTrend","action":"' + side + '","symbol":"' + syminfo.ticker +
     '","exchange":"' + syminfo.prefix + '","timeframe":"' + timeframe.period +
     '","price":' + str.tostring(px) + ',"sl":' + str.tostring(stp) +
     ',"tp1":' + str.tostring(t1) + ',"tp2":' + str.tostring(t2) + ',"tp3":' + str.tostring(t3) +
     ',"time":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ssZ", "UTC") + '"}'

slBuf = slBufT * syminfo.mintick
newTrade = false

if longSig
    e0 := f0L
    e1 := f1L
    eHard := loS - slBuf
    lastLegL := loT
    dLegT := phT
    dRevT := loT
    dRevA := loOp
    dRevB := loS
    newTrade := true
if shortSig
    e0 := f0S
    e1 := f1S
    eHard := hiS + slBuf
    lastLegS := hiT
    dLegT := plT
    dRevT := hiT
    dRevA := hiS
    dRevB := hiOp
    newTrade := true

if newTrade
    eStopC := fibAt(e0, e1, stopLvl)
    eTP1   := fibAt(e0, e1, tp1Lvl)
    eTP2   := fibAt(e0, e1, tp2Lvl)
    eTP3   := fibAt(e0, e1, tp3Lvl)
    beOn   := false

if longSig
    strategy.entry("Long", strategy.long)
    alert(jsonMsg("buy", close, eStopC, eTP1, eTP2, eTP3), alert.freq_once_per_bar_close)
if shortSig
    strategy.entry("Short", strategy.short)
    alert(jsonMsg("sell", close, eStopC, eTP1, eTP2, eTP3), alert.freq_once_per_bar_close)

// ───────────────────────────── Exits ─────────────────────────────
if strategy.position_size > 0 and not beOn and high >= eTP1
    beOn := moveBE
if strategy.position_size < 0 and not beOn and low <= eTP1
    beOn := moveBE

if strategy.position_size > 0 and not beOn and close < eStopC
    strategy.close("Long", comment = "SL close<0.65")
    alert(jsonMsg("close_long", close, eStopC, eTP1, eTP2, eTP3), alert.freq_once_per_bar_close)
if strategy.position_size < 0 and not beOn and close > eStopC
    strategy.close("Short", comment = "SL close>0.65")
    alert(jsonMsg("close_short", close, eStopC, eTP1, eTP2, eTP3), alert.freq_once_per_bar_close)

stopX = beOn ? strategy.position_avg_price : (useHard ? eHard : na)

if strategy.position_size > 0 or longSig
    strategy.exit("L-TP1", "Long", qty_percent = q1, limit = eTP1, stop = stopX, comment_profit = "TP1 0", comment_loss = beOn ? "BE" : "Hard SL")
    strategy.exit("L-TP2", "Long", qty_percent = q2, limit = eTP2, stop = stopX, comment_profit = "TP2 -0.6", comment_loss = beOn ? "BE" : "Hard SL")
    strategy.exit("L-TP3", "Long", limit = eTP3, stop = stopX, comment_profit = "TP3 -1.1", comment_loss = beOn ? "BE" : "Hard SL")

if strategy.position_size < 0 or shortSig
    strategy.exit("S-TP1", "Short", qty_percent = q1, limit = eTP1, stop = stopX, comment_profit = "TP1 0", comment_loss = beOn ? "BE" : "Hard SL")
    strategy.exit("S-TP2", "Short", qty_percent = q2, limit = eTP2, stop = stopX, comment_profit = "TP2 -0.6", comment_loss = beOn ? "BE" : "Hard SL")
    strategy.exit("S-TP3", "Short", limit = eTP3, stop = stopX, comment_profit = "TP3 -1.1", comment_loss = beOn ? "BE" : "Hard SL")

// ───────────────────────────── Drawing ─────────────────────────────
var array<line>  fLines  = array.new<line>()
var array<label> fLabels = array.new<label>()
var box revBox = na
lvls = array.from(1.0, stopLvl, entryLvl, tp1Lvl, tp2Lvl, tp3Lvl, -1.6, -1.9)

lvlColor(int i) =>
    switch i
        0 => color.red
        1 => color.green
        2 => color.green
        3 => color.gray
        4 => color.aqua
        5 => color.orange
        6 => color.fuchsia
        => color.blue

if showFib and newTrade
    for l in fLines
        line.delete(l)
    for lb in fLabels
        label.delete(lb)
    array.clear(fLines)
    array.clear(fLabels)
    box.delete(revBox)
    revBox := box.new(dRevT, math.max(dRevA, dRevB), dRevT + timeframe.in_seconds(fibTf) * 1000, math.min(dRevA, dRevB),
         xloc = xloc.bar_time, border_color = color.new(color.red, 40), bgcolor = color.new(color.red, 80))
    for [i, x] in lvls
        y = fibAt(e0, e1, x)
        fLines.push(line.new(dLegT, y, time, y, xloc = xloc.bar_time, color = lvlColor(i)))
        fLabels.push(label.new(time, y, str.tostring(x) + " (" + str.tostring(y, format.mintick) + ")",
             xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.white, 100),
             textcolor = lvlColor(i), size = size.small))

if showFib and strategy.position_size != 0 and array.size(fLines) > 0
    for l in fLines
        line.set_x2(l, time)
    for lb in fLabels
        label.set_x(lb, time)

plotshape(longSig,  "Buy",  shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(shortSig, "Sell", shape.triangledown, location.abovebar, color.red,   size = size.small)
plot(strategy.position_size != 0 and not beOn ? eStopC : na, "Stop (close)", color.red, style = plot.style_linebr)
plot(strategy.position_size != 0 ? eTP1 : na, "TP1 (0)",    color.gray,   style = plot.style_linebr)
plot(strategy.position_size != 0 ? eTP2 : na, "TP2 (-0.6)", color.aqua,   style = plot.style_linebr)
plot(strategy.position_size != 0 ? eTP3 : na, "TP3 (-1.1)", color.orange, style = plot.style_linebr)
